{
  "version": "1.0.0",
  "last_updated": "2025-03-15",
  "owner": "NuBrakes Analytics Team",
  "metrics": [
    {
      "metric_id": "rev_total",
      "display_name": "Total Revenue",
      "category": "revenue",
      "sub_category": "top_line",
      "description": "Total gross revenue collected across all service lines before refunds or discounts.",
      "unit": "USD",
      "format": "currency",
      "direction": "higher_is_better",
      "aggregation": "sum",
      "source_table": "orders",
      "source_column": "gross_revenue",
      "is_primary": true,
      "tags": ["revenue", "financial", "core"]
    },
    {
      "metric_id": "rev_brake_service",
      "display_name": "Brake Service Revenue",
      "category": "revenue",
      "sub_category": "service_line",
      "description": "Revenue from brake pad replacements, rotor resurfacing, and caliper services.",
      "unit": "USD",
      "format": "currency",
      "direction": "higher_is_better",
      "aggregation": "sum",
      "source_table": "orders",
      "source_column": "brake_service_revenue",
      "is_primary": false,
      "tags": ["revenue", "financial", "brake"]
    },
    {
      "metric_id": "rev_rotor_replacement",
      "display_name": "Rotor Replacement Revenue",
      "category": "revenue",
      "sub_category": "service_line",
      "description": "Revenue specifically attributed to full rotor replacement jobs.",
      "unit": "USD",
      "format": "currency",
      "direction": "higher_is_better",
      "aggregation": "sum",
      "source_table": "orders",
      "source_column": "rotor_replacement_revenue",
      "is_primary": false,
      "tags": ["revenue", "financial", "rotor"]
    },
    {
      "metric_id": "rev_flush_service",
      "display_name": "Brake Fluid Flush Revenue",
      "category": "revenue",
      "sub_category": "service_line",
      "description": "Revenue from brake fluid flush and bleed services.",
      "unit": "USD",
      "format": "currency",
      "direction": "higher_is_better",
      "aggregation": "sum",
      "source_table": "orders",
      "source_column": "flush_service_revenue",
      "is_primary": false,
      "tags": ["revenue", "financial", "flush"]
    },
    {
      "metric_id": "orders_completed",
      "display_name": "Completed Orders",
      "category": "operations",
      "sub_category": "throughput",
      "description": "Count of service orders marked as completed within the period.",
      "unit": "count",
      "format": "integer",
      "direction": "higher_is_better",
      "aggregation": "count",
      "source_table": "orders",
      "source_column": "order_id",
      "is_primary": true,
      "tags": ["operations", "volume", "core"]
    },
    {
      "metric_id": "orders_cancelled",
      "display_name": "Cancelled Orders",
      "category": "operations",
      "sub_category": "quality",
      "description": "Count of orders cancelled by customer or technician within the period.",
      "unit": "count",
      "format": "integer",
      "direction": "lower_is_better",
      "aggregation": "count",
      "source_table": "orders",
      "source_column": "order_id",
      "is_primary": false,
      "tags": ["operations", "quality"]
    },
    {
      "metric_id": "cancellation_rate",
      "display_name": "Cancellation Rate",
      "category": "operations",
      "sub_category": "quality",
      "description": "Percentage of total booked orders that were cancelled before service completion.",
      "unit": "percent",
      "format": "percent",
      "direction": "lower_is_better",
      "aggregation": "derived",
      "formula": "orders_cancelled / (orders_completed + orders_cancelled)",
      "is_primary": true,
      "tags": ["operations", "quality", "core"]
    },
    {
      "metric_id": "avg_order_value",
      "display_name": "Average Order Value",
      "category": "revenue",
      "sub_category": "unit_economics",
      "description": "Average gross revenue per completed order.",
      "unit": "USD",
      "format": "currency",
      "direction": "higher_is_better",
      "aggregation": "derived",
      "formula": "rev_total / orders_completed",
      "is_primary": true,
      "tags": ["revenue", "unit_economics", "core"]
    },
    {
      "metric_id": "tech_utilization_rate",
      "display_name": "Technician Utilization Rate",
      "category": "workforce",
      "sub_category": "efficiency",
      "description": "Percentage of available technician hours that were billable to completed orders.",
      "unit": "percent",
      "format": "percent",
      "direction": "higher_is_better",
      "aggregation": "derived",
      "formula": "billable_hours / available_hours",
      "is_primary": true,
      "tags": ["workforce", "efficiency", "core"]
    },
    {
      "metric_id": "tech_jobs_per_day",
      "display_name": "Jobs Per Technician Per Day",
      "category": "workforce",
      "sub_category": "throughput",
      "description": "Average number of completed jobs attributed to a single technician in a single day.",
      "unit": "count",
      "format": "decimal",
      "direction": "higher_is_better",
      "aggregation": "derived",
      "formula": "orders_completed / (active_technicians * working_days)",
      "is_primary": false,
      "tags": ["workforce", "throughput"]
    },
    {
      "metric_id": "csat_score",
      "display_name": "Customer Satisfaction Score",
      "category": "customer",
      "sub_category": "quality",
      "description": "Average post-service satisfaction score on a 1–5 scale from customer survey responses.",
      "unit": "score",
      "format": "decimal",
      "direction": "higher_is_better",
      "aggregation": "avg",
      "source_table": "reviews",
      "source_column": "satisfaction_score",
      "is_primary": true,
      "tags": ["customer", "quality", "core"]
    },
    {
      "metric_id": "nps_score",
      "display_name": "Net Promoter Score",
      "category": "customer",
      "sub_category": "loyalty",
      "description": "Net Promoter Score calculated from post-service survey responses (Promoters % minus Detractors %).",
      "unit": "score",
      "format": "integer",
      "direction": "higher_is_better",
      "aggregation": "derived",
      "formula": "pct_promoters - pct_detractors",
      "is_primary": true,
      "tags": ["customer", "loyalty", "core"]
    },
    {
      "metric_id": "review_response_rate",
      "display_name": "Review Response Rate",
      "category": "customer",
      "sub_category": "engagement",
      "description": "Percentage of completed orders for which a customer submitted a post-service review.",
      "unit": "percent",
      "format": "percent",
      "direction": "higher_is_better",
      "aggregation": "derived",
      "formula": "reviews_submitted / orders_completed",
      "is_primary": false,
      "tags": ["customer", "engagement"]
    },
    {
      "metric_id": "first_time_fix_rate",
      "display_name": "First-Time Fix Rate",
      "category": "quality",
      "sub_category": "rework",
      "description": "Percentage of jobs completed without requiring a return visit within 30 days for the same issue.",
      "unit": "percent",
      "format": "percent",
      "direction": "higher_is_better",
      "aggregation": "derived",
      "formula": "jobs_no_return / orders_completed",
      "is_primary": true,
      "tags": ["quality", "rework", "core"]
    },
    {
      "metric_id": "parts_cost_pct",
      "display_name": "Parts Cost as % of Revenue",
      "category": "financials",
      "sub_category": "margins",
      "description": "Total parts and materials cost expressed as a percentage of total revenue.",
      "unit": "percent",
      "format": "percent",
      "direction": "lower_is_better",
      "aggregation": "derived",
      "formula": "total_parts_cost / rev_total",
      "is_primary": false,
      "tags": ["financials", "margins", "cogs"]
    },
    {
      "metric_id": "gross_margin",
      "display_name": "Gross Margin",
      "category": "financials",
      "sub_category": "margins",
      "description": "Revenue minus direct cost of service (parts + technician labor). Expressed as a percentage.",
      "unit": "percent",
      "format": "percent",
      "direction": "higher_is_better",
      "aggregation": "derived",
      "formula": "(rev_total - direct_cost) / rev_total",
      "is_primary": true,
      "tags": ["financials", "margins", "core"]
    },
    {
      "metric_id": "new_customers",
      "display_name": "New Customers",
      "category": "growth",
      "sub_category": "acquisition",
      "description": "Count of unique customers placing their first-ever completed order with NuBrakes.",
      "unit": "count",
      "format": "integer",
      "direction": "higher_is_better",
      "aggregation": "count",
      "source_table": "customers",
      "source_column": "customer_id",
      "is_primary": true,
      "tags": ["growth", "acquisition", "core"]
    },
    {
      "metric_id": "repeat_customer_rate",
      "display_name": "Repeat Customer Rate",
      "category": "growth",
      "sub_category": "retention",
      "description": "Percentage of orders placed by customers who have previously completed at least one order.",
      "unit": "percent",
      "format": "percent",
      "direction": "higher_is_better",
      "aggregation": "derived",
      "formula": "orders_from_repeat_customers / orders_completed",
      "is_primary": true,
      "tags": ["growth", "retention", "core"]
    },
    {
      "metric_id": "market_coverage_pct",
      "display_name": "Market Coverage %",
      "category": "expansion",
      "sub_category": "geographic",
      "description": "Percentage of serviceable zip codes in a market that received at least one completed order in the period.",
      "unit": "percent",
      "format": "percent",
      "direction": "higher_is_better",
      "aggregation": "derived",
      "formula": "active_zip_codes / total_serviceable_zip_codes",
      "is_primary": false,
      "tags": ["expansion", "geographic"]
    },
    {
      "metric_id": "avg_dispatch_time_min",
      "display_name": "Average Dispatch Time (min)",
      "category": "operations",
      "sub_category": "speed",
      "description": "Average time in minutes from order booking confirmation to technician dispatch.",
      "unit": "minutes",
      "format": "integer",
      "direction": "lower_is_better",
      "aggregation": "avg",
      "source_table": "orders",
      "source_column": "dispatch_time_minutes",
      "is_primary": false,
      "tags": ["operations", "speed"]
    }
  ]
}
